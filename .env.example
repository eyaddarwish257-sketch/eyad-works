# Server-only chatbot configuration. Never prefix these with VITE_.
OPENAI_API_KEY=your_server_only_openai_key
OPENAI_MODEL=gpt-4o-mini

# Firebase client configuration. These identify the Firebase app; access is enforced by Firebase Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ADMIN_EMAIL=eyaddarwish257@gmail.com

# Optional existing integrations
VITE_EMAIL_PUBLIC_KEY=
VITE_EMAIL_SERVICE_ID=
VITE_EMAIL_TEMPLATE_ID=
