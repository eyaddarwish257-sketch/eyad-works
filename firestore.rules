rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'eyaddarwish257@gmail.com';
    }

    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /skills/{skillId} {
      allow read: if resource.data.enabled != false || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if resource.data.enabled != false || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /journey/{journeyId} {
      allow read: if resource.data.enabled != false || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /siteSettings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /profile/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /about/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hero/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if resource.data.enabled != false || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /aiSettings/{documentId} {
      allow read, write: if isAdmin();
    }

    match /aiKnowledge/{documentId} {
      allow read, write: if isAdmin();
    }
  }
}
